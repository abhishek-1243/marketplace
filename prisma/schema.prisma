generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ARTIST
  PRODUCER
  ADMIN
}

enum BeatStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  SOLD
}

enum ProducerStatus {
  APPLIED
  APPROVED
  SUSPENDED
}

enum CatalogKind {
  BEAT
  SOUND_PACK
}

enum RightsStatus {
  DECLARED
  REVIEW_REQUIRED
  RESTRICTED
}

enum DiscoveryTier {
  STOREFRONT
  MARKETPLACE
  FEATURED
}

enum AiDisclosure {
  NONE
  ASSISTED
  GENERATED
}

enum AssetType {
  PREVIEW
  MP3
  WAV
  STEMS
  PACK
}

enum LicenseType {
  BASIC
  PREMIUM
  EXCLUSIVE
  SOUND_PACK
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

enum ExclusiveState {
  AVAILABLE
  RESERVED
  SOLD
}

enum SampleDisclosure {
  NO_SAMPLES
  ROYALTY_FREE_OR_LICENSED
  INDIVIDUALLY_CLEARED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REVERSED
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  username           String     @unique
  displayName        String
  emailVerified      DateTime?
  termsAcceptedAt    DateTime?
  termsVersion       String?
  role               UserRole   @default(ARTIST)
  onboardingComplete Boolean    @default(false)
  phone              String?
  profileImage       String?
  banner             String?
  bio                String?
  genres             Json?
  instagram          String?
  youtube            String?
  spotify            String?
  otherLinks         String?
  legalName          String?
  payoutAccountId    String?    @unique
  verified           Boolean    @default(false)
  producerStatus     ProducerStatus @default(APPLIED)
  portfolioUrl       String?
  applicationNote    String?
  producerReviewedAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  beats              Beat[]
  receivedOrders     Order[]    @relation("ProducerOrders")
  orders             Order[]    @relation("ArtistOrders")
  favorites          Favorite[]
  following          Follow[]   @relation("Follower")
  followers          Follow[]   @relation("Following")
  downloads          Download[]
  auditLogs          AuditLog[] @relation("AuditActor")
}

model Beat {
  id                     String           @id @default(cuid())
  title                  String
  kind                   CatalogKind      @default(BEAT)
  slug                   String
  coverArt               String?
  genre                  String
  mood                   String?
  bpm                    Int?
  musicalKey             String?
  tags                   Json?
  description            String?
  region                 String?
  instruments            String?
  sampleCount            Int?
  startingPrice          Int              @default(0)
  aiDisclosure           AiDisclosure     @default(NONE)
  rightsEvidence         String?
  rightsStatus           RightsStatus     @default(REVIEW_REQUIRED)
  discoveryTier          DiscoveryTier    @default(STOREFRONT)
  qualityScore           Int              @default(0)
  qualityVersion         String           @default("readiness-v1")
  reviewFeedback         String?
  reviewedAt             DateTime?
  status                 BeatStatus       @default(DRAFT)
  plays                  Int              @default(0)
  sampleDisclosure       SampleDisclosure @default(NO_SAMPLES)
  rightsWarrantyAt       DateTime?
  exclusiveState         ExclusiveState   @default(AVAILABLE)
  exclusiveOrderId       String?          @unique
  exclusiveReservedAt    DateTime?
  exclusiveReservedUntil DateTime?
  producerId             String
  producer               User             @relation(fields: [producerId], references: [id], onDelete: Cascade)
  assets                 BeatAsset[]
  licensePlans           LicensePlan[]
  favorites              Favorite[]
  orders                 Order[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([producerId, slug])
  @@index([status, genre])
  @@index([producerId, status])
  @@index([kind, status, discoveryTier, qualityScore])
}

model BeatAsset {
  id          String    @id @default(cuid())
  type        AssetType
  objectKey   String
  contentType String
  sizeBytes   Int
  checksum    String?
  beatId      String
  beat        Beat      @relation(fields: [beatId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([beatId, type])
}

model LicensePlan {
  id                    String      @id @default(cuid())
  type                  LicenseType
  price                 Int
  currency              String      @default("INR")
  includesMp3           Boolean     @default(true)
  includesWav           Boolean     @default(false)
  includesStems         Boolean     @default(false)
  termMonths            Int?
  territory             String      @default("WORLDWIDE")
  masterRecordingLimit  Int         @default(1)
  streamingLimit        Int?
  videoLimit            Int?
  commercialUse         Boolean     @default(true)
  livePerformance       Boolean     @default(true)
  youtubeMonetization   Boolean     @default(true)
  contentIdAllowed      Boolean     @default(false)
  producerPublishingPct Int         @default(50)
  isExclusive           Boolean     @default(false)
  active                Boolean     @default(true)
  templateVersion       String      @default("2026-01")
  beatId                String
  beat                  Beat        @relation(fields: [beatId], references: [id], onDelete: Cascade)
  orders                Order[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([beatId, type])
  @@index([beatId, active])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  beatId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beat      Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, beatId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Order {
  id              String       @id @default(cuid())
  status          OrderStatus  @default(PENDING_PAYMENT)
  totalAmount     Int
  commission      Int
  producerAmount  Int
  currency        String       @default("INR")
  licenseSnapshot Json
  providerOrderId String?      @unique
  expiresAt       DateTime
  artistId        String
  artist          User         @relation("ArtistOrders", fields: [artistId], references: [id])
  producerId      String
  producer        User         @relation("ProducerOrders", fields: [producerId], references: [id])
  beatId          String
  beat            Beat         @relation(fields: [beatId], references: [id])
  licensePlanId   String
  licensePlan     LicensePlan  @relation(fields: [licensePlanId], references: [id])
  agreement       Agreement?
  payment         Payment?
  entitlement     Entitlement?
  downloads       Download[]
  payout          Payout?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([artistId, status])
  @@index([producerId, status])
}

model Agreement {
  id                String   @id @default(cuid())
  templateVersion   String
  content           String
  contentHash       String
  artistLegalName   String
  producerLegalName String
  acceptedAt        DateTime
  acceptedIp        String?
  acceptedUserAgent String?
  artifactKey       String?
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  status            PaymentStatus @default(CREATED)
  amount            Int
  currency          String        @default("INR")
  provider          String        @default("RAZORPAY")
  providerPaymentId String?       @unique
  method            String?
  capturedAt        DateTime?
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model PaymentEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  eventType       String
  payload         Json
  processedAt     DateTime @default(now())
}

model Entitlement {
  id        String    @id @default(cuid())
  active    Boolean   @default(true)
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Download {
  id        String    @id @default(cuid())
  fileType  AssetType
  ip        String?
  userAgent String?
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([orderId, createdAt])
}

model Payout {
  id          String       @id @default(cuid())
  status      PayoutStatus @default(PENDING)
  amount      Int
  currency    String       @default("INR")
  providerRef String?
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
