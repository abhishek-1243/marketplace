# Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
# Required: a working inbox; a personal Gmail address is fine for launch.
NEXT_PUBLIC_SUPPORT_EMAIL=

# PostgreSQL
DATABASE_URL=postgresql://soundfuel:password@localhost:5432/soundfuel?schema=public

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_MEDIA_BUCKET=
# Optional for profile/cover artwork uploads only. Never expose /beats through this CDN.
AWS_CLOUDFRONT_URL=
# Not needed while purchases are disabled.
AWS_SES_FROM_EMAIL=

# Razorpay
# Keep false during website verification. No Razorpay credentials are needed.
# Do not enable in this preview release; see docs/MVP.md for commerce blockers.
PAYMENTS_ENABLED=false
# Independent launch gate. Keep false for this catalog MVP, even with test keys.
COMMERCE_LAUNCH_APPROVED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Legacy commerce settings: not charged in the preview MVP.
# Proposed commercial model is documented in docs/MVP.md; activation is a separate release.
PLATFORM_COMMISSION_BPS=1000
PLATFORM_COMMISSION_CAP_INR=5000
LEGAL_TEMPLATE_VERSION=2026-01

# Optional bootstrap (npm run db:seed)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
